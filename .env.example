# ==============================================================================
# CarePulse / Patient-MGMT Environment Variables
# ==============================================================================
# Copy this file to .env.local and populate the values:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# Appwrite Backend Configuration
# ------------------------------------------------------------------------------
# Appwrite API Endpoint (e.g. https://cloud.appwrite.io/v1 or custom instance)
NEXT_PUBLIC_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite Project ID (Found in Project Settings)
PROJECT_ID=your_appwrite_project_id

# Appwrite Secret API Key (Generated in Project Settings -> API Keys)
# Required scopes: databases.*, users.*, storage.*, messaging.*
API_KEY=your_appwrite_api_key

# Appwrite Database & Collection IDs
DATABASE_ID=your_database_id
PATIENT_COLLECTION_ID=your_patient_collection_id
APPOINTMENT_COLLECTION_ID=your_appointment_collection_id
DOCTOR_COLLECTION_ID=your_doctor_collection_id

# Appwrite Storage Bucket ID (For patient ID document uploads)
NEXT_PUBLIC_BUCKET_ID=your_storage_bucket_id

# ------------------------------------------------------------------------------
# Admin Portal Security
# ------------------------------------------------------------------------------
# 6-digit numeric passkey for admin dashboard access verification
NEXT_PUBLIC_ADMIN_PASSKEY=123456

# ------------------------------------------------------------------------------
# Observability & Monitoring (Optional)
# ------------------------------------------------------------------------------
# Sentry Auth Token for uploading sourcemaps during production build
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
